<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.jobtracker</groupId>
    <artifactId>alexandra-job-tracker</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>coverage-jacoco</artifactId>
  <description>Module for aggregating JaCoCo code coverage reports across all submodules.
  </description>
  <packaging>pom</packaging>

  <dependencies>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>infrastructure-persistence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>infrastructure-auth</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>infrastructure-scraping</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>infrastructure-ai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>infrastructure-observability</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>adapter-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>adapter-cli</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>infrastructure-cache</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-site-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
