FROM ghcr.io/graalvm/native-image-community:25 AS native-build
WORKDIR /app
COPY . .
RUN ./mvnw clean install -DskipTests -B -ntp -e \
    && ./mvnw -Pnative native:compile -pl bootstrap-server -DskipTests -B -ntp -e

# Use a lightweight runtime image
FROM debian:12-slim
RUN apt-get update \
    && apt-get install -y curl gosu \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r appuser \
    && useradd -r -g appuser -d /app appuser
WORKDIR /app
COPY --from=native-build /app/bootstrap-server/target/job-tracker-server app
COPY --from=native-build /app/bootstrap-server/target/lib*.so /app/

COPY <<'EOF' /usr/local/bin/entrypoint.sh
#!/bin/sh
chown -R appuser:appuser /app/ 2>/dev/null || true
exec gosu appuser "$@"
EOF

RUN chmod 755 /usr/local/bin/entrypoint.sh
EXPOSE 8880
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/app/app", "--spring.profiles.active=dev"]
