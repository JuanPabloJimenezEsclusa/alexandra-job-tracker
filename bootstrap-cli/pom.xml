<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.jobtracker</groupId>
    <artifactId>alexandra-job-tracker</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>bootstrap-cli</artifactId>
  <description>Bootstrap CLI application for the Job Tracker, providing a command-line interface to
    interact with the system.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.jobtracker</groupId>
      <artifactId>adapter-cli</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.shell</groupId>
      <artifactId>spring-shell-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.shell</groupId>
      <artifactId>spring-shell-jline</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.shell</groupId>
      <artifactId>spring-shell-starter-test</artifactId>
      <version>${spring-shell.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*IntegrationTest.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*IntegrationTest.java</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <configuration>
          <imageName>job-tracker-cli</imageName>
          <mainClass>com.jobtracker.cli.JobTrackerCliApplication</mainClass>
          <buildArgs combine.children="append">
            <!-- https://bell-sw.com/blog/how-to-set-up-graalvm-native-image-debugging/ -->
            <buildArg>-g</buildArg>
            <!--
            (compile) Recommendations:
            G1GC: Use the G1 GC ('-gc=G1') for improved latency and throughput.
            PGO:  Use Profile-Guided Optimizations ('-pgo') for improved throughput.
            HEAP: Set max heap for improved and more predictable memory usage.
            CPU:  Enable more CPU features with '-march=native' for improved performance.
            QBM:  Use the quick build mode ('-Ob') to speed up builds during development.
            -->
            <buildArg>--emit build-report</buildArg>
            <buildArg>--gc=G1</buildArg>
            <buildArg>-R:MaxHeapSize=4g</buildArg>
            <buildArg>-march=native</buildArg>
            <buildArg>-Ob</buildArg>
            <!-- extras -->
            <buildArg>--no-fallback</buildArg>
            <buildArg>-J-Xmx8g</buildArg>
            <buildArg>--install-exit-handlers</buildArg>
          </buildArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
