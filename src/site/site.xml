<?xml version="1.0" encoding="UTF-8"?>
<project name="Alexandra Job Tracker"
  xmlns="http://maven.apache.org/DECORATION/1.8.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/DECORATION/1.8.0
    https://maven.apache.org/xsd/decoration-1.8.0.xsd">

  <skin>
    <groupId>io.github.devacfr.maven.skins</groupId>
    <artifactId>reflow-maven-skin</artifactId>
    <version>2.4.1</version>
  </skin>

  <custom>
    <reflowSkin>
      <theme>bootswatch-darkly</theme>
      <highlightJs>true</highlightJs>
      <smoothScroll>true</smoothScroll>
      <brand>
        <name>AJT</name>
        <href>index.html</href>
      </brand>
      <slogan>
        Alexandra Job Tracker.
        A job tracking application built with Spring Boot.
        Monitor and manage your job applications with ease.
      </slogan>
      <topNav>reports|modules</topNav>
      <bottomNav maxSpan="9">
        <column>main</column>
        <column>modules</column>
        <column>reports</column>
      </bottomNav>
    </reflowSkin>
  </custom>

  <bannerLeft>
    <name>AJT</name>
    <src>images/logo.png</src>
    <href>index.html</href>
  </bannerLeft>

  <publishDate position="bottom"/>
  <version position="bottom"/>

  <body>
    <breadcrumbs>
      <item name="AJT" href="/index.html"/>
    </breadcrumbs>

    <menu name="Overview" inherit="top">
      <item name="Home" href="/index.html"/>
      <item name="Documentation" href="/apidocs/index.html"/>
      <item name="Source Code" href="/xref/index.html"/>
    </menu>

    <menu ref="modules" inherit="bottom"/>
    <menu ref="reports" inherit="bottom"/>

    <footer>&#169; ${inceptionYear}&#8211;${currentYear} ${project.organization.name}</footer>
  </body>
</project>
